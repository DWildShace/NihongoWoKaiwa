# Cổng máy chủ backend
PORT=5001

# Lựa chọn nhà cung cấp AI mặc định: 'gemini' hoặc 'deepseek'
AI_PROVIDER=gemini

# Google Gemini API Key (lấy miễn phí từ https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API Key (lấy từ https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
